import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { PGlite } from "@electric-sql/pglite";

/**
 * Generates lib/meros/db/database.types.ts in the same shape as `supabase gen types typescript`,
 * by applying the migrations to an in-process Postgres (PGlite) and reading the catalog. Works
 * without Docker or a Supabase project. With the Supabase CLI linked, `supabase gen types
 * typescript --schema meros` produces the equivalent file.
 */
const root = process.cwd();
const db = new PGlite();
await db.exec(readFileSync(path.join(root, "tests/meros/supabase-shim.sql"), "utf8"));
for (const f of readdirSync(path.join(root, "supabase/migrations")).filter((f) => f.endsWith(".sql")).sort()) {
  await db.exec(readFileSync(path.join(root, "supabase/migrations", f), "utf8"));
}

const cols = await db.query<{ table_name: string; column_name: string; data_type: string; is_nullable: string; column_default: string | null }>(
  "select table_name, column_name, data_type, is_nullable, column_default from information_schema.columns where table_schema = 'meros' order by table_name, ordinal_position",
);

const ts = (t: string) =>
  ({ uuid: "string", text: "string", integer: "number", bigint: "number", boolean: "boolean", "timestamp with time zone": "string", date: "string", jsonb: "Json", "double precision": "number" })[t] ??
  "unknown";

const tables = new Map<string, typeof cols.rows>();
for (const c of cols.rows) tables.set(c.table_name, [...(tables.get(c.table_name) ?? []), c]);

let out = `// Generated by \`npm run meros:types\` from supabase/migrations. Do not edit by hand.\n\nexport type Json = string | number | boolean | null | { [key: string]: Json | undefined } | Json[];\n\nexport type Database = {\n  meros: {\n    Tables: {\n`;
for (const [name, list] of [...tables.entries()].sort()) {
  const row = list.map((c) => `          ${c.column_name}: ${ts(c.data_type)}${c.is_nullable === "YES" ? " | null" : ""};`).join("\n");
  const ins = list
    .map((c) => `          ${c.column_name}${c.is_nullable === "YES" || c.column_default !== null ? "?" : ""}: ${ts(c.data_type)}${c.is_nullable === "YES" ? " | null" : ""};`)
    .join("\n");
  const upd = list.map((c) => `          ${c.column_name}?: ${ts(c.data_type)}${c.is_nullable === "YES" ? " | null" : ""};`).join("\n");
  out += `      ${name}: {\n        Row: {\n${row}\n        };\n        Insert: {\n${ins}\n        };\n        Update: {\n${upd}\n        };\n        Relationships: [];\n      };\n`;
}
out += `    };\n    Views: { [_ in never]: never };\n    Functions: {\n      is_allowed_owner: { Args: Record<PropertyKey, never>; Returns: boolean };\n      ledger_drift: { Args: { p_owner: string }; Returns: { metric: string; cached: number; ledger: number }[] };\n    };\n    Enums: { [_ in never]: never };\n    CompositeTypes: { [_ in never]: never };\n  };\n};\n`;
writeFileSync(path.join(root, "lib/meros/db/database.types.ts"), out);
console.log(`Wrote lib/meros/db/database.types.ts (${tables.size} tables)`);
