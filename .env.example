# Earned (the /earned tab). Copy to .env.local for local development; never commit real values.
# Without these, /earned still offers the demo (synthetic data, in-browser only).

# Supabase project URL and publishable (anon) key: public, safe in the browser because of RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Secret (service-role) key: used only for private evidence storage. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only. Postgres connection string for game transactions. Use the pooler's transaction mode
# (port 6543) from Supabase → Connect. Keep the password out of git.
EARNED_DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Comma-separated emails allowed to use Earned (private allowlist).
EARNED_OWNER_EMAILS=you@example.com

# Photo verification. "anthropic" uses Claude vision; leave unset to fail closed (photo check-ins
# are then unavailable, never auto-accepted). "test" accepts everything and is refused in production.
EARNED_VISION_PROVIDER=anthropic
EARNED_VISION_MODEL=claude-opus-5-5
EARNED_VISION_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=sk-ant-...

# Protects /earned/api/cron (Vercel Cron sends it as a Bearer token automatically).
CRON_SECRET=a-long-random-string
